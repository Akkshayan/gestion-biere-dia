<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Historique - StockBiere DIAGO</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <%- include("partials/entete", { utilisateur }) %>

  <main class="page-historique">
    <h1>Historique des mouvements</h1>

    <table class="tableau-historique">
      <thead>
        <tr>
          <th>Date</th>
          <th>Reference</th>
          <th>Type</th>
          <th>Quantite</th>
          <th>Utilisateur</th>
        </tr>
      </thead>
      <tbody>
        <% mouvements.forEach(function(m) { %>
          <tr>
            <td><%= new Date(m.date).toLocaleString('fr-FR') %></td>
            <td><%= m.nom_reference %></td>
            <td><%= m.type === 'entree' ? 'Entree' : 'Sortie' %></td>
            <td><%= m.quantite %></td>
            <td><%= m.nom_utilisateur %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </main>
</body>
</html>